{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.js?action=$1"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/camera",
      "dest": "/camera.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
