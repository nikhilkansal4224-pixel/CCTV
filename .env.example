# Sentinel CCTV Environment Variables
PORT=3000
HTTPS_PORT=3443
NODE_ENV=production

# MongoDB Connection String (Atlas or self-hosted)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/sentinel_cctv?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/sentinel_cctv?retryWrites=true&w=majority

# JWT / Cookie Authentication Secret
AUTH_SECRET=sentinel-ultra-secure-jwt-secret-replace-in-production

# Vercel Deployment Note:
# When deploying to Vercel, set MONGODB_URI and AUTH_SECRET in your Vercel Project Settings > Environment Variables.
