# MongoDB Connection String (Optional on Vercel)
# If left empty on Vercel, the app automatically uses an in-memory fallback.
# For production persistence on Vercel, create a free MongoDB Atlas database at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cctv_surveillance?retryWrites=true&w=majority

# Local Development MongoDB
# MONGODB_URI=mongodb://localhost:27017

# Database Name (default: cctv_surveillance)
DB_NAME=cctv_surveillance

# ==============================================================================
# Google OAuth 2.0 Client ID
# ==============================================================================
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Add to "Authorized JavaScript origins":
#    - http://localhost:3001
#    - http://localhost:3000
#    - https://your-domain.vercel.app
# 4. Add to "Authorized redirect URIs":
#    - http://localhost:3001/
#    - https://your-domain.vercel.app/
# 5. Paste your Client ID below:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
