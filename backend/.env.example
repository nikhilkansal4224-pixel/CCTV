# ==============================================================================
# ARGUS CCTV SURVEILLANCE SUITE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (default: 3001)
PORT=3001

# MongoDB Connection String (Optional on Vercel)
# Local Development:
MONGODB_URI=mongodb://localhost:27017
# Or for MongoDB Atlas cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cctv_surveillance?retryWrites=true&w=majority

# Database Name (default: cctv_surveillance)
DB_NAME=cctv_surveillance

# ==============================================================================
# Google OAuth 2.0 Client ID
# ==============================================================================
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Add to "Authorized JavaScript origins":
#    - http://localhost:3001
#    - http://localhost:3000
#    - https://your-project.vercel.app
# 4. Add to "Authorized redirect URIs":
#    - http://localhost:3001/
#    - https://your-project.vercel.app/
# 5. Set your Client ID below:
GOOGLE_CLIENT_ID=473264498286-5l7grtjn65fbm8jq57v141hefb185uum.apps.googleusercontent.com

# ==============================================================================
# Sentinel Operator & Security Overrides (Optional)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123
ADMIN_PIN=7777
ADMIN_EMAIL=admin@argus-surveillance.net
SESSION_SECRET=argus_sec_
